{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "organizations",
    "ClientId": "<azinventory-web-client-id>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "ClientCredentials": [
      {
        "SourceType": "SignedAssertionFromManagedIdentity",
        "ManagedIdentityClientId": "<uami-client-id>"
      }
    ]
  },
  "Security": {
    "AllowedTenantIds": []
  },
  "AzureResourceManager": {
    "Scopes": [ "https://management.azure.com/user_impersonation" ]
  },
  "AzureMcp": {
    "Enabled": true,
    "Endpoint": "https+http://azure-mcp",
    "Scopes": [ "api://<azinventory-mcp-client-id>/Mcp.Tools.Read" ],
    "AllowedTools": [
      "azmcp_subscription_list",
      "azmcp_group_list",
      "azmcp_appservice_webapp_get",
      "azmcp_functionapp_get",
      "azmcp_sql_server_get",
      "azmcp_sql_db_get",
      "azmcp_storage_account_get",
      "azmcp_containerapps_list",
      "azmcp_acr_registry_list",
      "azmcp_acr_registry_repository_list",
      "azmcp_cosmos_list",
      "azmcp_redis_list",
      "azmcp_resourcehealth_availability-status_get",
      "azmcp_monitor_metrics_query"
    ],
    "TimeoutSeconds": 60
  },
  "Inventory": {
    "MaxParallelism": 8,
    "IncludeSlots": true,
    "IncludeFunctionApps": true,
    "ReadConfigFiles": true,
    "ConfigFilePatterns": [ "appsettings.json", "appsettings.*.json" ],
    "MaxConfigFileBytes": 1048576,
    "MaxBlobContainersPerAccount": 200,
    "ScmHostSuffixes": [ ".azurewebsites.net", ".appserviceenvironment.net" ],
    "CloudEndpointSuffixes": {
      "Sql": [ ".database.windows.net" ],
      "Storage": [ ".core.windows.net" ],
      "Cosmos": [ ".documents.azure.com" ],
      "Redis": [ ".redis.cache.windows.net", ".redis.azure.net", ".redisenterprise.cache.azure.net" ],
      "ServiceBus": [ ".servicebus.windows.net" ],
      "KeyVault": [ ".vault.azure.net" ],
      "ContainerRegistry": [ ".azurecr.io" ]
    }
  },
  "GraphSession": {
    "SlidingExpirationMinutes": 30,
    "AbsoluteExpirationHours": 8,
    "MaxSessions": 500
  },
  "AI": {
    "AllowedAzureAIHostSuffixes": [ ".openai.azure.com", ".services.ai.azure.com", ".cognitiveservices.azure.com" ],
    "Tools": {
      "Enabled": true,
      "MaxCallsPerTurn": 8,
      "MaxResultsHardCap": 100
    },
    "Defaults": {
      "Temperature": 0.2,
      "MaxOutputTokens": 2048
    },
    "DefaultProvider": {
      "ServiceType": "",
      "ApiKey": "",
      "Endpoint": "",
      "ApiVersion": "",
      "DeploymentPath": "",
      "ApiProtocol": "",
      "AIModel": ""
    }
  },
  "Tagging": {
    "Enabled": true,
    "MaxParallelWrites": 4,
    "MaxResourcesPerBatch": 200,
    "MaxResourcesPerProposal": 200,
    "ProposalTtlMinutes": 60,
    "StaleScanWarningHours": 24,
    "PermissionCacheMinutes": 10,
    "Connections": {
      "Prefix": "conn",
      "OutSegment": "out",
      "InSegment": "in",
      "UpdatedTagName": "conn-updated",
      "Separator": ";",
      "MaxValueLength": 256,
      "IncludeStructural": false,
      "IncludeLowConfidence": false,
      "IncludeExternal": true,
      "WriteWhenEmpty": true,
      "EdgeTypes": [ "CONNECTS_TO", "PULLS_IMAGE_FROM", "REFERENCES_SECRET" ]
    }
  }
}
