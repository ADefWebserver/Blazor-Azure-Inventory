<div class="tool-card">
    <RadzenPanel AllowCollapse="true" Collapsed="true">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="flex: 1;">
                <RadzenIcon Icon="@(Call.IsLiveAzureTool ? "cloud_sync" : "hub")" class="summary-icon" />
                <span class="mono">@Call.Name</span>
                @if (Call.IsRunning)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                }
                else
                {
                    <RadzenBadge Text="@(Call.ResultSummary ?? "")" Shade="Shade.Lighter" IsPill="true"
                                 BadgeStyle="@(Call.Failed ? BadgeStyle.Danger : BadgeStyle.Info)" />
                }
            </RadzenStack>
        </HeaderTemplate>
        <ChildContent>
            <RadzenText TextStyle="TextStyle.Caption" class="muted rz-m-0">Input</RadzenText>
            <div class="mono">@(string.IsNullOrEmpty(Call.ArgumentSummary) ? "(none)" : Call.ArgumentSummary)</div>
        </ChildContent>
    </RadzenPanel>
</div>

@code {
    [Parameter, EditorRequired] public ToolCallInfo Call { get; set; } = default!;
}
