@inject NavigationManager Nav

<RadzenCard class="centered-card rz-p-8">
    <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenIcon Icon="lock" class="big-icon" />
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">Sign in required</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" class="muted">Connect to Azure to view this page.</RadzenText>
        <RadzenButton Text="Connect to Azure" Icon="login" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" Click="@SignIn" />
        <RadzenText TextStyle="TextStyle.Caption" class="muted">Read-only. Secret values are never stored or displayed.</RadzenText>
    </RadzenStack>
</RadzenCard>

@code {
    private void SignIn()
    {
        var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo($"MicrosoftIdentity/Account/SignIn?redirectUri={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
