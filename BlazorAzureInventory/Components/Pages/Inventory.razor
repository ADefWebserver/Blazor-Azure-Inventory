@page "/inventory"
@attribute [Authorize]
@implements IDisposable
@using BlazorAzureInventory.Components.Inventory
@using BlazorAzureInventory.Services.Azure
@using BlazorAzureInventory.Services.Persistence
@using BlazorAzureInventory.Services.Scan
@using Microsoft.Identity.Web
@inject AzureContextService AzureContextService
@inject InventoryScanOrchestrator Orchestrator
@inject InventorySessionStore Store
@inject InventorySessionLoader Loader
@inject UserPreferencesService Preferences
@inject BlazorAzureInventory.Services.Changes.ChangeTrackingService ChangeTracking
@inject BlazorAzureInventory.Services.Reports.ReportExportService Reports
@inject BlazorAzureInventory.Services.Reports.FileDownloadService Downloads
@inject BlazorAzureInventory.Services.Quotas.UserQuotaService Quotas
@inject UserContextAccessor UserContext
@inject DialogService DialogService
@inject NotificationService Notifications
@inject NavigationManager Nav
@inject MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler
@inject Microsoft.Extensions.Options.IOptions<BlazorAzureInventory.Models.Options.TaggingOptions> TaggingOptions

<PageTitle>Inventory - Azure Inventory</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
        <RadzenStack Gap="0">
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="page-title">Inventory</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="muted rz-m-0">Resources and configuration connections across your subscriptions.</RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            @if (_loadingContext)
            {
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            }
            else
            {
                <SubscriptionPicker Context="@_context" @bind-SelectedIds="_selected" @bind-SelectedIds:after="SaveSelectionAsync" OnGrantAccess="@GrantAccess" Disabled="@_scanning" />
            }
            <RadzenButton Text="@(_snapshot is null ? "Scan" : "Refresh from Azure")" Icon="@(_snapshot is null ? "play_arrow" : "refresh")" ButtonStyle="ButtonStyle.Primary" Click="@ScanAsync"
                          Disabled="@(_scanning || !_selected.Any())" IsBusy="@_scanning" BusyText="Scanning..." />
            @if (_scanning)
            {
                <RadzenButton Text="Cancel" Icon="stop" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@Cancel" />
            }
            else if (TaggingOptions.Value.Enabled)
            {
                <RadzenButton Text="Tag connections..." Icon="sell" ButtonStyle="ButtonStyle.Light" Click="@OpenBulkTaggingAsync"
                              Disabled="@(_snapshot is null)" title="Write conn-out-* and conn-in-* tags that list what each resource connects to" />
            }
            @if (!_scanning && _snapshot is not null)
            {
                <RadzenButton Text="Excel report" Icon="table_view" ButtonStyle="ButtonStyle.Light" Click="@ExportExcelAsync" IsBusy="@_exporting"
                              title="Download every inventory table, connections, tags, scan issues, and changes as one workbook" />
                <RadzenButton Text="CSV" Icon="download" ButtonStyle="ButtonStyle.Light" Click="@ExportCsvAsync" Disabled="@_exporting"
                              title="Download the current tab as CSV" />
            }
        </RadzenStack>
    </RadzenStack>

    <ScanAgeBadge Snapshot="@_snapshot" Source="@_source" Style="align-self: flex-end;" />

    @if (_hiddenSubscriptions > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="true">
            @_hiddenSubscriptions subscription@(_hiddenSubscriptions == 1 ? " from your saved scan is" : "s from your saved scan are") no longer accessible and @(_hiddenSubscriptions == 1 ? "was" : "were") hidden. Refresh to update.
        </RadzenAlert>
    }
    @if (Loader.LastOutcome == SessionLoadOutcome.AccessCheckFailed)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="true">
            Your saved scan was not shown because your current Azure access could not be confirmed. Grant access or refresh from Azure.
        </RadzenAlert>
    }

    @if (_scanning)
    {
        <ScanProgressPanel Progress="@_progress" />
    }

    @if (_snapshot is null && !_scanning)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false">Select subscriptions and click Scan to start.</RadzenAlert>
    }

    @if (_snapshot?.Issues.Count > 0 && !_scanning)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <span>
                    @_snapshot.Issues.Count resource@(_snapshot.Issues.Count == 1 ? "" : "s") could not be fully read. Results are partial.
                    @if (AzureRoleRequirements.Detect(_snapshot.Issues) is { Count: > 0 } missingRoles)
                    {
                        <strong> Missing Azure role@(missingRoles.Count == 1 ? "" : "s"): @string.Join(", ", missingRoles.Select(m => m.Role)).</strong>
                    }
                </span>
                <RadzenButton Text="View issues" Variant="Variant.Text" Size="ButtonSize.Small" Click="@ShowIssuesAsync" />
            </RadzenStack>
        </RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="1rem">
        @foreach (var card in SummaryCards())
        {
            <RadzenCard class="summary-card">
                <RadzenStack Gap="0.25rem">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.Overline" class="muted rz-m-0">@card.Label</RadzenText>
                        <RadzenIcon Icon="@card.Icon" class="summary-icon" />
                    </RadzenStack>
                    <span class="summary-count">@card.Count</span>
                    <RadzenText TextStyle="TextStyle.Caption" class="muted rz-m-0">@card.Caption</RadzenText>
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>

    <RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndex="@_tabIndex" Change="@OnTabChangedAsync">
        <Tabs>
            <RadzenTabsItem Text="Web & Function Apps" Icon="language">
                <WebAppsGrid Data="@(_view?.Apps ?? [])" IsLoading="@_scanning" OnViewConfiguration="@ViewConfiguration" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="SQL" Icon="storage">
                <SqlGrid Data="@(_view?.SqlServers ?? [])" IsLoading="@_scanning" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Storage" Icon="folder">
                <StorageGrid Data="@(_view?.Storage ?? [])" IsLoading="@_scanning" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Container Apps" Icon="deployed_code">
                <ContainerAppsGrid Data="@(_view?.ContainerApps ?? [])" IsLoading="@_scanning" OnViewConfiguration="@ViewConfiguration" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Registries" Icon="inventory">
                <RegistriesGrid Data="@(_view?.Registries ?? [])" IsLoading="@_scanning" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Other" Icon="category">
                <OtherResourcesGrid Data="@(_view?.Other ?? [])" IsLoading="@_scanning" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="@(_changes is { TotalCount: > 0 } ? $"Changes ({_changes.TotalCount})" : "Changes")" Icon="difference">
                <ChangesPanel Changes="@_changes" />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenStack>

@code {
    private AzureContext? _context;
    private IEnumerable<string> _selected = [];
    private bool _loadingContext = true;
    private bool _scanning;
    private ScanProgress? _progress;
    private InventorySnapshot? _snapshot;
    private InventoryView? _view;
    private CancellationTokenSource? _cts;
    private DateTime _lastProgressRender;
    private string? _sessionKey;
    private SessionDataSource? _source;
    private int _hiddenSubscriptions;
    private int _tabIndex;
    private SnapshotDiff? _changes;
    private bool _exporting;

    private static readonly string[] TabTitles = ["Web & Function Apps", "SQL", "Storage", "Container Apps", "Registries", "Other", "Changes"];

    protected override async Task OnInitializedAsync()
    {
        var user = await UserContext.GetUserAsync();
        _sessionKey = InventorySessionStore.KeyFor(user);
        Store.TagsChanged += OnTagsChanged;
        var prefs = await Preferences.GetAsync();
        _tabIndex = Math.Max(0, Array.IndexOf(TabTitles, prefs.InventoryTab));
        if (await Loader.EnsureLoadedAsync() is { Snapshot: { } snapshot } session)
        {
            _snapshot = snapshot;
            _view = InventoryView.Build(snapshot, session.Index);
            _selected = snapshot.Subscriptions.Select(s => s.SubscriptionId).ToList();
            _source = session.Source;
            _hiddenSubscriptions = session.HiddenSubscriptions;
            _changes = await ChangeTracking.GetChangesAsync();
        }

        try
        {
            _context = await AzureContextService.GetContextAsync();
            if (prefs.SelectedSubscriptionIds.Count > 0)
            {
                var saved = prefs.SelectedSubscriptionIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
                var restored = _context.Subscriptions.Where(s => saved.Contains(s.SubscriptionId)).Select(s => s.SubscriptionId).ToList();
                if (restored.Count > 0) _selected = restored;
            }
            else if (_snapshot is null)
            {
                _selected = _context.Subscriptions.Where(s => s.State == "Enabled").Select(s => s.SubscriptionId).ToList();
            }
        }
        catch (Exception ex)
        {
            ConsentHandler.HandleException(ex);
        }
        finally
        {
            _loadingContext = false;
        }
    }

    private Task SaveSelectionAsync() =>
        Preferences.UpdateAsync(p => p.SelectedSubscriptionIds = _selected.ToList());

    private async Task ExportExcelAsync()
    {
        if (_snapshot is not { } snapshot || !await CheckReportQuotaAsync()) return;
        _exporting = true;
        try
        {
            var user = await UserContext.GetUserAsync();
            var index = Store.Get(user)?.Index;
            var generatedBy = UserClaims.GetUsername(user) ?? "unknown";
            using var content = await Task.Run(() => Reports.BuildInventoryWorkbook(snapshot, index, _changes, generatedBy));
            await Downloads.DownloadAsync($"inventory-report-{DateTime.UtcNow:yyyyMMdd-HHmm}.xlsx",
                BlazorAzureInventory.Services.Reports.ReportExportService.ExcelContentType, content);
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        if (_snapshot is not { } snapshot || !await CheckReportQuotaAsync()) return;
        var index = Store.Get(await UserContext.GetUserAsync())?.Index;
        var name = TabTitles.ElementAtOrDefault(_tabIndex) ?? TabTitles[0];
        var table = Reports.BuildTables(snapshot, index, _changes).FirstOrDefault(t => t.Name == name);
        if (table is null)
        {
            Notifications.Notify(NotificationSeverity.Info, "Nothing to export", "This tab has no data to export.");
            return;
        }
        using var content = Reports.BuildCsv(table);
        var slug = new string(name.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray()).Trim('-');
        await Downloads.DownloadAsync($"inventory-{slug}-{DateTime.UtcNow:yyyyMMdd-HHmm}.csv",
            BlazorAzureInventory.Services.Reports.ReportExportService.CsvContentType, content);
    }

    private async Task<bool> CheckReportQuotaAsync()
    {
        var result = Quotas.TryReport(await UserContext.GetUserAsync());
        if (!result.Allowed) Notifications.Notify(NotificationSeverity.Warning, "Download not started", result.Message ?? "");
        return result.Allowed;
    }

    private Task OnTabChangedAsync(int index)
    {
        _tabIndex = index;
        return Preferences.UpdateAsync(p => p.InventoryTab = TabTitles.ElementAtOrDefault(index));
    }

    private async Task ScanAsync()
    {
        if (_context is null) return;
        _cts = new CancellationTokenSource();
        _scanning = true;
        _progress = null;

        var selected = _selected.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var subscriptions = _context.Subscriptions.Where(s => selected.Contains(s.SubscriptionId)).ToList();
        var tenantIds = subscriptions.Select(s => s.TenantId).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var request = new ScanRequest(_context.Tenants.Where(t => tenantIds.Contains(t.TenantId)).ToList(), subscriptions);

        try
        {
            _snapshot = await Task.Run(() => Orchestrator.ScanAsync(request, new Progress(this), _cts.Token));
            var session = Store.Get(await UserContext.GetUserAsync());
            _view = InventoryView.Build(_snapshot, session?.Index);
            _source = SessionDataSource.Scan;
            _hiddenSubscriptions = 0;
            _changes = await ChangeTracking.GetChangesAsync();
            Notifications.Notify(NotificationSeverity.Success, "Scan complete",
                $"{_snapshot.Resources.Count} resources in {_snapshot.ScopeDescription}.");
            if (Orchestrator.LastSaveError is { } saveError)
            {
                Notifications.Notify(NotificationSeverity.Warning, "Not saved", saveError);
            }
        }
        catch (OperationCanceledException)
        {
            Notifications.Notify(NotificationSeverity.Info, "Scan cancelled", "Partial results were discarded.");
        }
        catch (BlazorAzureInventory.Services.Quotas.QuotaExceededException ex)
        {
            Notifications.Notify(NotificationSeverity.Warning, "Scan not started", ex.Message);
        }
        catch (Exception ex)
        {
            ConsentHandler.HandleException(ex);
        }
        finally
        {
            _scanning = false;
            _cts?.Dispose();
            _cts = null;
        }
    }

    private void Cancel() => _cts?.Cancel();

    private void GrantAccess(TenantInfo tenant)
    {
        string? claims = null;
        for (var e = AzureContextService.GetConsentError(tenant.TenantId); e is not null; e = e.InnerException)
        {
            if (e is MicrosoftIdentityWebChallengeUserException { MsalUiRequiredException.Claims: { Length: > 0 } c }) { claims = c; break; }
            if (e is Microsoft.Identity.Client.MsalServiceException { Claims: { Length: > 0 } s }) { claims = s; break; }
        }

        Nav.NavigateTo(TenantAccess.BuildUrl(tenant.TenantId, "/inventory", claims), forceLoad: true);
    }

    private async Task ShowIssuesAsync()
    {
        var user = await UserContext.GetUserAsync();
        await DialogService.OpenAsync<ScanIssuesDialog>(
            $"Scan issues ({_snapshot!.Issues.Count})",
            new Dictionary<string, object?>
            {
                [nameof(ScanIssuesDialog.Issues)] = _snapshot.Issues,
                [nameof(ScanIssuesDialog.Subscriptions)] = _snapshot.Subscriptions,
                [nameof(ScanIssuesDialog.Assignee)] = user.FindFirst("preferred_username")?.Value
            },
            new DialogOptions { Width = "960px", Resizable = true });
    }

    private void ViewConfiguration(AzureResourceInfo resource) =>
        Nav.NavigateTo($"appconfiguration?id={Uri.EscapeDataString(resource.Id)}");

    private Task OpenBulkTaggingAsync() =>
        DialogService.OpenAsync<BulkConnectionTagDialog>("Tag connections", new Dictionary<string, object?>(),
            new DialogOptions { Width = "1000px", Resizable = true, Draggable = true, CloseDialogOnEsc = true });

    /// <summary>Rebuilds grid rows after a tag write so the Tags columns stay current. Re-renders are coalesced.</summary>
    private int _tagRefreshPending;

    private void OnTagsChanged(string sessionKey, string resourceId)
    {
        if (sessionKey != _sessionKey || Interlocked.Exchange(ref _tagRefreshPending, 1) == 1) return;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(250);
            Interlocked.Exchange(ref _tagRefreshPending, 0);
            var session = Store.Get(await UserContext.GetUserAsync());
            if (session?.Snapshot is { } snapshot && !_scanning)
            {
                _snapshot = snapshot;
                _view = InventoryView.Build(snapshot, session.Index);
                StateHasChanged();
            }
        });
    }

    private IEnumerable<(string Label, string Icon, string Count, string Caption)> SummaryCards()
    {
        string N(int? v) => v?.ToString() ?? "-";
        var v = _view;
        yield return ("Web Apps", "language", N(v?.WebAppCount), v is null ? "" : $"{v.SlotCount} slots");
        yield return ("Function Apps", "bolt", N(v?.FunctionAppCount), "");
        yield return ("SQL", "storage", v is null ? "-" : $"{v.SqlServers.Count} / {v.SqlDatabaseCount}", "servers / databases");
        yield return ("Storage", "folder", v is null ? "-" : $"{v.Storage.Count} / {v.ContainerCount}", "accounts / containers");
        yield return ("Container Apps", "deployed_code", N(v?.ContainerApps.Count), "");
        yield return ("Registries", "inventory", N(v?.Registries.Count), "");
        yield return ("Other", "category", N(v?.Other.Count), "Cosmos, Redis, Service Bus, Key Vault");
    }

    /// <summary>Re-renders at most every 150 ms so large scans keep the UI responsive.</summary>
    private sealed class Progress(Inventory page) : IProgress<ScanProgress>
    {
        public void Report(ScanProgress value)
        {
            page._progress = value;
            var now = DateTime.UtcNow;
            if ((now - page._lastProgressRender).TotalMilliseconds < 150 && value.Completed < value.Total) return;
            page._lastProgressRender = now;
            _ = page.InvokeAsync(page.StateHasChanged);
        }
    }

    public void Dispose()
    {
        Store.TagsChanged -= OnTagsChanged;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
