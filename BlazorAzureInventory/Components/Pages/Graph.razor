@page "/graph"
@attribute [Authorize]
@implements IDisposable
@using BlazorAzureInventory.Components.Graph
@using BlazorAzureInventory.Models.Options
@using BlazorAzureInventory.Services.Persistence
@using BlazorAzureInventory.Services.Scan
@inject InventorySessionStore Store
@inject InventorySessionLoader Loader
@inject UserPreferencesService Preferences
@inject GraphViewService GraphViews
@inject GraphLayoutService GraphLayouts
@inject BlazorAzureInventory.Services.Changes.ChangeTrackingService ChangeTracking
@inject BlazorAzureInventory.Services.Reports.FileDownloadService Downloads
@inject UserContextAccessor UserContext
@inject GraphQueryService GraphQueries
@inject InventoryScanOrchestrator Orchestrator
@inject ResourceDialogLauncher Launcher
@inject NavigationManager Nav
@inject NotificationService Notifications
@inject DialogService Dialogs
@inject Microsoft.Extensions.Options.IOptions<GraphViewOptions> GraphViewOptions

<PageTitle>Knowledge Graph - Azure Inventory</PageTitle>

<RadzenStack Gap="0.75rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="hub" class="summary-icon" />
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="page-title">Knowledge Graph</RadzenText>
        </RadzenStack>
        @if (_graph is not null)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <ScanAgeBadge Snapshot="@_snapshot" Source="@_source" ShowNever="false" />
                <RadzenText TextStyle="TextStyle.Caption" class="muted rz-m-0">@_graph.ScopeDescription</RadzenText>
                @if (_changes is { TotalCount: > 0 })
                {
                    <RadzenButton Text="@(_showChanges ? "Hide changes" : $"Show changes ({_changes.TotalCount})")" Icon="difference" Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light" Click="@ToggleChangesAsync"
                                  title="Outline resources added (green) or changed (orange) since the previous scan" />
                }
                @if (_route is not null)
                {
                    <RadzenButton Text="Copy link" Icon="content_copy" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@CopyLinkAsync" />
                }
                <details class="graph-overflow">
                    <summary aria-label="More graph actions"><RadzenIcon Icon="more_vert" /></summary>
                    <div class="graph-overflow-menu">
                        <button type="button" @onclick="RebuildAsync">Rebuild graph</button>
                        <button type="button" @onclick="ExportJsonAsync">Export JSON</button>
                    </div>
                </details>
            </RadzenStack>
        }
    </RadzenStack>

    @if (_route is not null && _index is not null)
    {
        <nav class="graph-breadcrumb" aria-label="Graph navigation">
            <button type="button" @onclick="() => NavigateToBreadcrumbAsync(-1)">Overview</button>
            <span aria-hidden="true">›</span>
            @for (var i = -1; i < _route.Expand.Count; i++)
            {
                var expandedCount = i + 1;
                var id = i < 0 ? _route.Focus : _route.Expand[i];
                var label = _index.NodesById.GetValueOrDefault(id)?.Label ?? id;
                <button type="button" aria-current="@(i == _route.Expand.Count - 1 ? "page" : null)"
                        @onclick="() => NavigateToBreadcrumbAsync(expandedCount)">@label</button>
                @if (i < _route.Expand.Count - 1)
                {
                    <span aria-hidden="true">›</span>
                }
            }
        </nav>
    }

    @if (_graph is null || _index is null || _facets is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <span>No graph available. Run a scan first.</span>
                <RadzenButton Text="Go to Inventory and Scan" Icon="inventory_2" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                              Click="@(() => Nav.NavigateTo("inventory"))" />
            </RadzenStack>
        </RadzenAlert>
    }
    else
    {
        <RadzenSplitter class="graph-page">
            <RadzenSplitterPane Size="280px" Min="200px" Collapsible="true">
                <GraphFilterPanel Facets="@_facets" Filter="@_filter" Nodes="@_graph.Nodes" TagsVersion="@_tagsVersion" FilterChanged="@ApplyFilterAsync" OnFindNode="@NavigateToFocus" />
            </RadzenSplitterPane>
            <RadzenSplitterPane>
                <div class="graph-pane" style="overflow: hidden;">
                    <GraphCanvas @ref="_canvas" View="@_view" Filter="@_filter" OnNodeSelected="@OnNodeSelected" OnRendered="@OnRenderedAsync"
                             OnNodeOpen="@OpenDetailsByIndexAsync" OnEdgeSelected="@OnEdgeSelected" />
                </div>
            </RadzenSplitterPane>
            <RadzenSplitterPane Size="340px" Min="240px" Collapsible="true">
            <NodePropertiesPanel Node="@_selected" Edge="@_selectedEdge" Edges="@_selectedEdges" Index="@_index" OnOpenDetails="@OpenDetailsAsync"
                                 OnFocus="@NavigateToFocus" OnExpand="@ExpandSelectedAsync"
                                 IsFocusMode="@(_route is not null)" CanExpand="@CanExpandSelected"
                                 ExpandDisabledReason="@ExpandDisabledReason"
                                 FocusId="@_route?.Focus" Dependencies="@_dependencies"
                                 AggregateLabel="@_selectedAggregate?.Label" AggregateMembers="@_selectedAggregate?.Members" />
            </RadzenSplitterPane>
        </RadzenSplitter>
    }
</RadzenStack>

@code {
    [SupplyParameterFromQuery(Name = "focus")] public string? Focus { get; set; }
    [SupplyParameterFromQuery(Name = "expand")] public string[]? Expand { get; set; }

    private GraphDocument? _graph;
    private GraphIndex? _index;
    private GraphViewPayload? _view;
    private GraphFacets? _facets;
    private IReadOnlyList<DependencyGroup> _dependencies = [];
    private GraphNode? _selected;
    private GraphEdge? _selectedEdge;
    private IReadOnlyList<GraphEdge> _selectedEdges = [];
    private (string Label, IReadOnlyList<DependencyGroup> Members)? _selectedAggregate;
    private GraphCanvas? _canvas;
    private string? _sessionKey;
    private InventorySession? _session;
    private InventorySnapshot? _snapshot;
    private SessionDataSource? _source;
    private SnapshotDiff? _changes;
    private GraphFocusRoute? _route;
    private bool _initialized;
    private bool _routeRendered;
    private bool _showChanges;
    // Latest route render or Overview reload; an awaited result is published only while its number is still current.
    private int _renderGeneration;
    // ShowChildResources of the newest Overview load, in flight or published; null when no Overview is loading or shown.
    private bool? _overviewTarget;
    // Server-side filter values the current Focus payload was built with; null when no Focus payload is shown.
    private (bool HideEmulator, bool ShowLowConfidence)? _focusBuiltWith;
    private int _tagsVersion;
    private readonly GraphFilterState _filter = new()
    {
        NodeTypes = NodeTypeStyles.All.Select(t => t.Type).Where(t => !NodeTypeStyles.HiddenByDefault.Contains(t)).ToList()
    };

    protected override async Task OnInitializedAsync()
    {
        var user = await UserContext.GetUserAsync();
        _sessionKey = InventorySessionStore.KeyFor(user);
        var session = await Loader.EnsureLoadedAsync();
        _session = session;
        _snapshot = session?.Snapshot;
        _source = session?.Source;
        RestoreFilter((await Preferences.GetAsync()).GraphFilter);
        _changes = await ChangeTracking.GetChangesAsync();
        Store.TagsChanged += OnTagsChanged;
        _initialized = true;
        await RenderRouteAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized) await RenderRouteAsync();
    }

    private void RestoreFilter(GraphFilterState? saved)
    {
        if (saved is null) return;
        saved.Upgrade();
        _filter.NodeTypes = NodeTypeStyles.RestoreVisibleTypes(saved);
        _filter.Subscriptions = saved.Subscriptions.ToList();
        _filter.ResourceGroups = saved.ResourceGroups.ToList();
        _filter.OnlyConnected = saved.OnlyConnected;
        _filter.HideExternal = saved.HideExternal;
        _filter.HideEmulator = saved.HideEmulator;
        _filter.ShowLowConfidence = saved.ShowLowConfidence;
        _filter.ShowChildResources = saved.ShowChildResources;
        _filter.FilterVersion = saved.FilterVersion;
        _filter.TagName = saved.TagName is { Length: <= 512 } name ? name : null;
        _filter.TagValue = saved.TagValue is { Length: <= 256 } value ? value : null;
    }

    private void Load(GraphDocument? graph, GraphIndex? index)
    {
        _graph = graph;
        _index = index;
        _facets = index is null ? null : GraphQueries.GetFacets(index);
        _selected = null;
        _selectedEdge = null;
        _selectedEdges = [];
        _selectedAggregate = null;
    }

    private async Task ApplyFilterAsync()
    {
        if (_route is null && _session is not null && _filter.ShowChildResources != _overviewTarget)
        {
            await LoadOverviewAsync(_session, _filter.ShowChildResources, ++_renderGeneration);
        }
        else if (_route is not null && _focusBuiltWith != (_filter.HideEmulator, _filter.ShowLowConfidence))
        {
            // BuildFocus drops these nodes and edges on the server, so the browser filter cannot bring them back.
            await RenderRouteAsync(force: true);
        }
        else
        {
            await ApplyFilterToCanvasAsync();
        }
        await Preferences.UpdateAsync(p => p.GraphFilter = new GraphFilterState
        {
            FilterVersion = GraphFilterState.CurrentFilterVersion,
            NodeTypes = _filter.NodeTypes.ToList(),
            KnownNodeTypes = NodeTypeStyles.All.Select(t => t.Type).ToList(),
            Subscriptions = _filter.Subscriptions.ToList(),
            ResourceGroups = _filter.ResourceGroups.ToList(),
            OnlyConnected = _filter.OnlyConnected,
            HideExternal = _filter.HideExternal,
            HideEmulator = _filter.HideEmulator,
            ShowLowConfidence = _filter.ShowLowConfidence,
            ShowChildResources = _filter.ShowChildResources,
            TagName = _filter.TagName,
            TagValue = _filter.TagValue
        });
    }

    private void NavigateToFocus(string id) => NavigateToRoute(new GraphFocusRoute(id, []));

    private Task ExpandSelectedAsync(string id)
    {
        if (_route is null) return Task.CompletedTask;
        if (_route.Expand.Count >= GraphViewOptions.Value.MaxExpandInUrl)
        {
            Notifications.Notify(NotificationSeverity.Info, "Expansion limit reached",
                $"A Focus link can include at most {GraphViewOptions.Value.MaxExpandInUrl} expanded resources.");
            return Task.CompletedTask;
        }
        if (_view is null || _view.Nodes.Count >= GraphViewOptions.Value.FocusMaxNodes)
        {
            Notifications.Notify(NotificationSeverity.Info, "Focus limit reached",
                $"Focus view is limited to {GraphViewOptions.Value.FocusMaxNodes} resources. Start a new focus from this resource instead.");
            return Task.CompletedTask;
        }
        if (_route.Expand.Contains(id, StringComparer.OrdinalIgnoreCase)
            || id.Equals(_route.Focus, StringComparison.OrdinalIgnoreCase)) return Task.CompletedTask;
        NavigateToRoute(_route with { Expand = _route.Expand.Append(id).ToList() });
        return Task.CompletedTask;
    }

    private bool CanExpandSelected =>
        _route is not null && _selected is not null
        && !_selected.Id.Equals(_route.Focus, StringComparison.OrdinalIgnoreCase)
        && !_route.Expand.Contains(_selected.Id, StringComparer.OrdinalIgnoreCase)
        && _route.Expand.Count < GraphViewOptions.Value.MaxExpandInUrl
        && (_view?.Nodes.Count ?? 0) < GraphViewOptions.Value.FocusMaxNodes;

    private string? ExpandDisabledReason
    {
        get
        {
            if (_route is null || _selected is null) return null;
            if (_route.Expand.Contains(_selected.Id, StringComparer.OrdinalIgnoreCase))
                return "This resource is already expanded.";
            if (_route.Expand.Count >= GraphViewOptions.Value.MaxExpandInUrl)
                return $"A Focus link can include at most {GraphViewOptions.Value.MaxExpandInUrl} expanded resources.";
            if ((_view?.Nodes.Count ?? 0) >= GraphViewOptions.Value.FocusMaxNodes)
                return $"Focus view is limited to {GraphViewOptions.Value.FocusMaxNodes} resources. Start a new focus from this resource instead.";
            return null;
        }
    }

    private void NavigateToRoute(GraphFocusRoute? route, bool replace = false)
    {
        var parameters = new Dictionary<string, object?>
        {
            ["focus"] = route?.Focus,
            ["expand"] = route?.Expand.ToArray()
        };
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(parameters), replace: replace);
    }

    private Task NavigateToBreadcrumbAsync(int expandedCount)
    {
        if (expandedCount < 0)
        {
            NavigateToRoute(null);
            return Task.CompletedTask;
        }
        if (_route is null) return Task.CompletedTask;
        NavigateToRoute(_route with { Expand = _route.Expand.Take(expandedCount).ToList() });
        return Task.CompletedTask;
    }

    private void OnNodeSelected(int? nodeIndex)
    {
        _selectedAggregate = null;
        _selectedEdge = null;
        if (nodeIndex is { } aggregateIndex && _view is not null && _index is not null
            && _view.Aggregates.TryGetValue(aggregateIndex, out var membership) && aggregateIndex < _view.Nodes.Count)
        {
            _selectedAggregate = (_view.Nodes[aggregateIndex].Label, GraphViews.SummarizeMembers(_index, membership));
            _selected = null;
            return;
        }
        var id = nodeIndex is { } i && _view is not null && i >= 0 && i < _view.NodeIds.Count
            ? _view.NodeIds[i]
            : null;
        _selected = id is not null && _index?.NodesById.TryGetValue(id, out var node) == true ? node : null;
    }

    private void OnEdgeSelected(int? edgeIndex)
    {
        _selectedAggregate = null;
        var edgeIds = edgeIndex is { } i && _view is not null && i >= 0 && i < _view.EdgeSources.Count
            ? _view.EdgeSources[i]
            : [];
        var edgesById = edgeIds.Count == 0 ? null : _graph?.Edges.ToDictionary(e => e.Id, StringComparer.Ordinal);
        _selectedEdges = edgesById is null
            ? []
            : edgeIds.Select(id => edgesById.GetValueOrDefault(id)).OfType<GraphEdge>().ToList();
        _selectedEdge = _selectedEdges.FirstOrDefault();
        _selected = null;
    }

    private Task OpenDetailsByIndexAsync(int index)
    {
        var id = _view is not null && index >= 0 && index < _view.NodeIds.Count ? _view.NodeIds[index] : null;
        return id is null ? Task.CompletedTask : OpenDetailsAsync(id);
    }

    private Task OpenDetailsAsync(string id) =>
        _index?.NodesById.TryGetValue(id, out var node) == true && node.Type != nameof(AzureResourceKind.Tenant)
            ? Launcher.OpenAsync(node.Id, node.Label)
            : Task.CompletedTask;

    private void OnTagsChanged(string sessionKey, string resourceId)
    {
        if (sessionKey != _sessionKey) return;
        _ = InvokeAsync(async () =>
        {
            // Tags change in place on the same node list, so the filter panel needs a new version to refresh suggestions.
            _tagsVersion++;
            if (_canvas is not null) await ApplyFilterToCanvasAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _renderGeneration++;
        Store.TagsChanged -= OnTagsChanged;
    }

    private async Task OnRenderedAsync()
    {
        await ApplyFilterToCanvasAsync();
        if (_showChanges) await ApplyChangeHighlightAsync();
    }

    private async Task ToggleChangesAsync()
    {
        _showChanges = !_showChanges;
        await ApplyChangeHighlightAsync();
    }

    private Task ApplyChangeHighlightAsync()
    {
        if (_canvas is null || _view is null) return Task.CompletedTask;
        var added = _showChanges && _changes is not null
            ? IndicesFor(_changes.AddedIds)
            : [];
        var changed = _showChanges && _changes is not null
            ? IndicesFor(_changes.ChangedIds)
            : [];
        return _canvas.HighlightChangesAsync(added, changed);
    }

    private IReadOnlyList<int> IndicesFor(IEnumerable<string> ids)
    {
        if (_view is null) return [];
        var wanted = ids.ToHashSet(StringComparer.OrdinalIgnoreCase);
        return _view.NodeIds.Select((id, index) => (id, index))
            .Where(item => wanted.Contains(item.id))
            .Select(item => item.index)
            .ToList();
    }

    private Task ApplyFilterToCanvasAsync()
    {
        IReadOnlyList<int>? tagMatches = null;
        if (_view is not null && _index is not null && !string.IsNullOrWhiteSpace(_filter.TagName))
            tagMatches = GraphViews.MatchTag(_view, _index, _filter.TagName, _filter.TagValue);
        return _canvas is null ? Task.CompletedTask : _canvas.ApplyFilterAsync(_filter, tagMatches);
    }

    private async Task ExportJsonAsync()
    {
        if (_graph is null) return;
        using var content = new MemoryStream();
        await System.Text.Json.JsonSerializer.SerializeAsync(content, _graph, GraphJson.Options);
        await Downloads.DownloadAsync($"inventory-graph-{DateTime.UtcNow:yyyyMMdd-HHmm}.json", "application/json", content);
    }

    private async Task RebuildAsync()
    {
        var graph = await Orchestrator.RebuildGraphAsync();
        var session = Store.Get(await UserContext.GetUserAsync());
        if (graph is not null)
        {
            _session = session;
            _snapshot = session?.Snapshot;
            _source = session?.Source;
            await RenderRouteAsync(force: true);
        }
    }

    private async Task RenderRouteAsync(bool force = false)
    {
        if (!_initialized && !force) return;
        var requested = GraphFocusRoute.Parse(Focus, Expand, GraphViewOptions.Value.MaxExpandInUrl, out var droppedExpand);
        if (!force && _routeRendered && Equals(requested, _route)) return;

        // Incremented after the unchanged-route check so a no-op parameter set does not abandon an in-flight load.
        var generation = ++_renderGeneration;
        _route = null;
        _dependencies = [];
        Load(_session?.Graph, _session?.Index);
        _view = null;
        _overviewTarget = null;
        _focusBuiltWith = null;
        if (_session?.Index is not { } index || _session.Graph is null)
        {
            _routeRendered = true;
            return;
        }

        if (requested is null)
        {
            if (droppedExpand > 0)
                Notifications.Notify(NotificationSeverity.Info, "Expanded resources ignored", $"{droppedExpand} expanded resource(s) were ignored.");
            if (!await LoadOverviewAsync(_session, _filter.ShowChildResources, generation)) return;
            _routeRendered = true;
            if (Focus is not null || (Expand?.Length ?? 0) > 0) NavigateToRoute(null, replace: true);
            return;
        }

        if (!index.NodesById.TryGetValue(requested.Focus, out var focusNode))
        {
            Notifications.Notify(NotificationSeverity.Info, "Resource not in scan", "This resource is not in your current scan.");
            if (!await LoadOverviewAsync(_session, _filter.ShowChildResources, generation)) return;
            _routeRendered = true;
            NavigateToRoute(null, replace: true);
            return;
        }

        if (focusNode.Type is nameof(AzureResourceKind.Tenant) or nameof(AzureResourceKind.Subscription) or nameof(AzureResourceKind.ResourceGroup))
        {
            var (subscriptions, resourceGroups) = ScopeFilterFor(focusNode);
            if (!await LoadOverviewAsync(_session, _filter.ShowChildResources, generation)) return;
            // Committed only once the request is current, so an abandoned scope link never changes the filters.
            if (subscriptions is not null) _filter.Subscriptions = subscriptions;
            if (resourceGroups is not null) _filter.ResourceGroups = resourceGroups;
            _routeRendered = true;
            NavigateToRoute(null, replace: true);
            return;
        }

        var acceptedExpansions = new List<string>();
        var droppedUnknown = droppedExpand;
        var view = GraphViews.BuildFocus(index, requested.Focus, acceptedExpansions,
            _filter.HideEmulator, _filter.ShowLowConfidence);
        foreach (var id in requested.Expand)
        {
            if (!index.NodesById.ContainsKey(id) || view is null || !view.NodeIds.Contains(id, StringComparer.OrdinalIgnoreCase))
            {
                droppedUnknown++;
                continue;
            }
            var candidate = GraphViews.BuildFocus(index, requested.Focus, acceptedExpansions.Append(id).ToList(),
                _filter.HideEmulator, _filter.ShowLowConfidence);
            if (candidate is null || !ExpansionAddsContent(view, candidate))
            {
                droppedUnknown++;
                continue;
            }
            acceptedExpansions.Add(id);
            view = candidate;
        }

        _route = new GraphFocusRoute(requested.Focus, acceptedExpansions);
        _view = view;
        _focusBuiltWith = (_filter.HideEmulator, _filter.ShowLowConfidence);
        _selected = focusNode;
        _selectedEdge = null;
        _selectedEdges = [];
        _selectedAggregate = null;
        _dependencies = GraphViews.SummarizeDependencies(index, requested.Focus);
        _routeRendered = true;
        if (droppedUnknown > 0)
        {
            Notifications.Notify(NotificationSeverity.Info, "Expanded resources ignored", $"{droppedUnknown} expanded resource(s) were not in this Focus view.");
            NavigateToRoute(_route, replace: true);
        }
    }

    private static bool ExpansionAddsContent(GraphViewPayload previous, GraphViewPayload candidate)
    {
        if (candidate.NodeIds.Count > previous.NodeIds.Count) return true;
        var previousEdges = previous.EdgeSources.SelectMany(sources => sources).ToHashSet(StringComparer.Ordinal);
        return candidate.EdgeSources.SelectMany(sources => sources).Any(id => !previousEdges.Contains(id));
    }

    /// <summary>The scope filter a scope-node Focus link applies; a <c>null</c> list leaves that filter unchanged.</summary>
    private static (List<string>? Subscriptions, List<string>? ResourceGroups) ScopeFilterFor(GraphNode node)
    {
        if (node.Type == nameof(AzureResourceKind.Subscription)
            && node.Data.GetValueOrDefault("subscriptionId")?.ToString() is { Length: > 0 } subscription)
            return ([subscription], null);
        // Resource-group names repeat across subscriptions, so the group's own subscription is applied too when known.
        if (node.Type == nameof(AzureResourceKind.ResourceGroup)
            && node.Data.GetValueOrDefault("resourceGroup")?.ToString() is { Length: > 0 } resourceGroup)
            return (node.Data.GetValueOrDefault("subscriptionId")?.ToString() is { Length: > 0 } groupSubscription
                ? [groupSubscription]
                : [], [resourceGroup]);
        if (node.Type == nameof(AzureResourceKind.Tenant))
            return ([], []);
        return (null, null);
    }

    /// <summary>
    /// Loads the Overview for <paramref name="showChildResources"/>. Returns <c>false</c>, without changing the page,
    /// when <paramref name="generation"/> is no longer the latest request once the layout is ready.
    /// </summary>
    private async Task<bool> LoadOverviewAsync(InventorySession session, bool showChildResources, int generation)
    {
        if (session.Index is not { } index || session.Graph is null) return false;
        _overviewTarget = showChildResources;
        GraphLayout layout;
        try
        {
            layout = await GraphLayouts.GetOverviewLayoutAsync(session, showChildResources, CancellationToken.None);
        }
        catch (Exception) when (generation != _renderGeneration)
        {
            return false;
        }
        if (generation != _renderGeneration) return false;
        _view = GraphViews.BuildOverview(index, layout, showChildResources);
        _focusBuiltWith = null;
        _selected = null;
        _selectedEdge = null;
        _selectedEdges = [];
        _selectedAggregate = null;
        return true;
    }

    private async Task CopyLinkAsync()
    {
        var uri = Nav.Uri;
        try
        {
            if (_canvas is not null && await _canvas.CopyTextAsync(uri))
            {
                Notifications.Notify(NotificationSeverity.Success, "Link copied", "The Focus link was copied to the clipboard.");
                return;
            }
        }
        catch (JSException)
        {
        }
        // Completes when the dialog closes; Radzen keeps Tab inside it and restores focus to Copy link afterwards.
        await Dialogs.OpenAsync<CopyLinkDialog>("Copy graph link",
            new Dictionary<string, object?> { [nameof(CopyLinkDialog.Url)] = uri },
            new DialogOptions
            {
                Width = "32rem",
                // Otherwise Radzen's autofocus timer moves focus from the link field to the title-bar close button.
                AutoFocusFirstElement = false,
                CloseDialogOnEsc = true,
                CloseDialogOnOverlayClick = true
            });
    }
}
