@page "/settings"
@attribute [Authorize]
@using BlazorAzureInventory.Models.Options
@using BlazorAzureInventory.Models.Users
@using BlazorAzureInventory.Services.AI
@using BlazorAzureInventory.Services.Auth
@using BlazorAzureInventory.Services.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SessionAISettingsService SettingsService
@inject IUserDataStore DataStore
@inject IOptions<PersistenceOptions> PersistenceOptions
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Settings - Azure Inventory</PageTitle>

<RadzenStack Gap="1rem" Style="max-width: 860px;">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="page-title">Settings</RadzenText>

    <RadzenCard class="rz-p-6">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Your access</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Wrap="FlexWrap.Wrap">
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.Overline" class="muted rz-m-0">Username</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1" class="mono rz-m-0">@(_username ?? "-")</RadzenText>
                </RadzenStack>
                <RadzenStack Gap="0">
                    <RadzenText TextStyle="TextStyle.Overline" class="muted rz-m-0">App role</RadzenText>
                    <RadzenBadge BadgeStyle="@(_role == AppRoles.Admin ? BadgeStyle.Primary : BadgeStyle.Light)" Text="@(_role ?? "None")" />
                </RadzenStack>
            </RadzenStack>
            <RadzenText TextStyle="TextStyle.Caption" class="muted rz-m-0">
                The app role controls who can use and manage this app only. Your Azure permissions are unchanged.
            </RadzenText>
            <AuthorizeView Policy="@AppPolicies.Admin">
                <RadzenLink Path="admin/users" Text="Manage users" Icon="manage_accounts" />
            </AuthorizeView>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard class="rz-p-6">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Saved data</RadzenText>
            @if (!DataStore.IsPersistent)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" AllowClose="false">
                    Persistent storage is not available. Scans are kept for this session only.
                </RadzenAlert>
            }
            else if (_info?.Summary is { } summary)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                    Last saved scan: @summary.ScannedUtc.ToString("yyyy-MM-dd HH:mm 'UTC'") &nbsp;•&nbsp; @summary.ResourceCount resources
                    in @summary.SubscriptionCount subscription@(summary.SubscriptionCount == 1 ? "" : "s") &nbsp;•&nbsp; @FormatSize(_info.SnapshotBytes)
                </RadzenText>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" class="muted rz-m-0">No saved scan yet. Your next scan is saved automatically.</RadzenText>
            }
            @if (DataStore.IsPersistent)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="muted rz-m-0">
                    Your last scan and preferences are saved so pages open without rescanning Azure. They are visible only to you and
                    are deleted after @PersistenceOptions.Value.RetentionDays days without use. Secret values are never saved.
                </RadzenText>
                <RadzenButton Text="Delete my saved data" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                              Click="@DeleteSavedDataAsync" Disabled="@_deleting" Style="align-self: flex-start;" />
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mt-2 rz-mb-0">AI Settings</RadzenText>

    <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" AllowClose="false" Icon="shield">
        Your API key is kept only for this session, is encrypted in memory, and is never saved.
        @if (SettingsService.DefaultServiceType is { } defaultType)
        {
            @($" A default {AIServiceTypes.ToDisplayName(defaultType)} provider is configured for this app, so entering your own key is optional.")
        }
    </RadzenAlert>

    <RadzenCard class="rz-p-6">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Model provider</RadzenText>
                <RadzenButton Text="Clear session credentials" Icon="restart_alt" Variant="Variant.Text" Size="ButtonSize.Small" Click="@ClearAsync" />
            </RadzenStack>
            <AIServiceSettingsEditor @ref="_editor" />
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    private AIServiceSettingsEditor? _editor;
    private string? _username;
    private string? _role;
    private SavedDataInfo? _info;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _username = UserClaims.GetUsername(user);
        _role = UserClaims.GetAppRole(user);
        if (UserKey.FromPrincipal(user) is { } key) _info = await DataStore.GetInfoAsync(key, CancellationToken.None);
    }

    private async Task DeleteSavedDataAsync()
    {
        var confirmed = await DialogService.Confirm(
            "Delete your saved scan and preferences? The current session keeps working until you sign out.",
            "Delete saved data", new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed != true) return;

        _deleting = true;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (UserKey.FromPrincipal(user) is { } key)
            {
                await DataStore.DeleteAllAsync(key, CancellationToken.None);
                _info = await DataStore.GetInfoAsync(key, CancellationToken.None);
            }
            NotificationService.Notify(NotificationSeverity.Success, "Deleted", "Your saved data was deleted.");
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Not deleted", "Your saved data could not be deleted. Try again later.");
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:0.0} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    private async Task ClearAsync()
    {
        await SettingsService.ClearAsync();
        if (_editor is not null) await _editor.ReloadAsync();
        NotificationService.Notify(NotificationSeverity.Info, "Cleared", "AI settings and keys were removed from this session.");
    }
}
