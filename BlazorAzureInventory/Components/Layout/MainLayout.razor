@inherits LayoutComponentBase

<RadzenComponents />

<RadzenLayout class="app-layout">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="app-header">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)" />
                <RadzenIcon Icon="cloud" class="app-logo" />
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.Span" class="app-title">Azure Inventory</RadzenText>
            </RadzenStack>
            <LoginDisplay />
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="_sidebarExpanded" class="app-sidebar">
        <NavMenu />
    </RadzenSidebar>
    <RadzenBody Style="padding: 0;">
        <div class="app-content">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _sidebarExpanded = true;
}
