@implements IDisposable
@inject InventorySessionStore Store
@inject AuthenticationStateProvider AuthState

<RadzenStack Gap="0" Style="height: 100%;" JustifyContent="JustifyContent.SpaceBetween">
    <div>
        <RadzenText TextStyle="TextStyle.Overline" TagName="TagName.Span" class="nav-caption">Navigation</RadzenText>
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Icon="home" Path="" Match="NavLinkMatch.All" />
            @if (_signedIn)
            {
                <RadzenPanelMenuItem Text="Inventory" Icon="inventory_2" Path="inventory" />
                <RadzenPanelMenuItem Text="Knowledge Graph" Icon="hub" Path="graph" Disabled="@(!_hasScan)"
                                     title="@(_hasScan ? null : "Run a scan first")" />
                <RadzenPanelMenuItem Text="AI Chat" Icon="chat" Path="chat" Disabled="@(!_hasScan)"
                                     title="@(_hasScan ? null : "Run a scan first")" />
                <RadzenPanelMenuItem Text="Settings" Icon="settings" Path="settings" />
                @if (_isAdmin)
                {
                    <RadzenPanelMenuItem Text="Users" Icon="manage_accounts" Path="admin/users" />
                }
            }
        </RadzenPanelMenu>
    </div>
    @if (_signedIn && _domain is not null)
    {
        <div class="nav-footer">
            <RadzenText TextStyle="TextStyle.Overline" TagName="TagName.Div" class="muted">Active directory</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Div" class="mono">@_domain</RadzenText>
        </div>
    }
</RadzenStack>

@code {
    private bool _signedIn;
    private bool _isAdmin;
    private bool _hasScan;
    private string? _domain;
    private string? _sessionKey;

    protected override async Task OnInitializedAsync()
    {
        Store.SessionChanged += OnSessionChanged;
        AuthState.AuthenticationStateChanged += OnAuthChanged;
        await RefreshAsync(AuthState.GetAuthenticationStateAsync());
    }

    private async Task RefreshAsync(Task<AuthenticationState> stateTask)
    {
        var user = (await stateTask).User;
        _signedIn = user.Identity?.IsAuthenticated == true;
        _isAdmin = _signedIn && UserClaims.GetAppRole(user) == BlazorAzureInventory.Models.Users.AppRoles.Admin;
        _sessionKey = _signedIn ? InventorySessionStore.KeyFor(user) : null;
        _hasScan = _signedIn && Store.Get(user)?.Snapshot is not null;
        var upn = user.FindFirst("preferred_username")?.Value;
        _domain = upn is not null && upn.Contains('@') ? upn[(upn.IndexOf('@') + 1)..] : null;
    }

    private void OnAuthChanged(Task<AuthenticationState> stateTask) =>
        _ = InvokeAsync(async () => { await RefreshAsync(stateTask); StateHasChanged(); });

    private void OnSessionChanged(string key)
    {
        if (key != _sessionKey) return;
        _ = InvokeAsync(async () => { await RefreshAsync(AuthState.GetAuthenticationStateAsync()); StateHasChanged(); });
    }

    public void Dispose()
    {
        Store.SessionChanged -= OnSessionChanged;
        AuthState.AuthenticationStateChanged -= OnAuthChanged;
    }
}
