@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="graph-canvas-host">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2" Wrap="FlexWrap.Wrap">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Fit" Icon="fit_screen" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@FitAsync" />
            <RadzenButton Text="@(_physics ? "Freeze physics" : "Resume physics")" Icon="@(_physics ? "pause" : "play_arrow")"
                          Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@TogglePhysicsAsync" Disabled="@_rendering" />
            <RadzenButton Text="Rebuild graph" Icon="refresh" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Click="@(() => OnRebuild.InvokeAsync())" IsBusy="@_rendering" />
        </RadzenStack>
        <RadzenText TextStyle="TextStyle.Caption" class="muted rz-m-0">@_nodeCount nodes, @_edgeCount edges</RadzenText>
    </RadzenStack>
    <div id="@_containerId" class="graph-canvas"></div>
    @if (_rendering)
    {
        <div class="graph-overlay">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body2" class="muted">Laying out graph...</RadzenText>
        </div>
    }
</div>

@code {
    [Parameter] public GraphDocument? Graph { get; set; }
    [Parameter] public GraphFilterState Filter { get; set; } = new();
    [Parameter] public EventCallback<string?> OnNodeSelected { get; set; }
    [Parameter] public EventCallback<string> OnNodeOpen { get; set; }
    [Parameter] public EventCallback<string?> OnEdgeSelected { get; set; }
    [Parameter] public EventCallback OnRendered { get; set; }
    [Parameter] public EventCallback OnRebuild { get; set; }

    private readonly string _containerId = $"graph-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<GraphCanvas>? _selfRef;
    private GraphDocument? _renderedGraph;
    private bool _rendering = true;
    private bool _physics;
    private int _nodeCount;
    private int _edgeCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/graph-view.js");
            _selfRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _containerId, _selfRef);
            await _module.InvokeVoidAsync("applyFilter", Filter);
        }

        if (_module is not null && Graph is not null && !ReferenceEquals(Graph, _renderedGraph))
        {
            _renderedGraph = Graph;
            await RenderGraphAsync(Graph);
        }
    }

    private async Task RenderGraphAsync(GraphDocument graph)
    {
        _rendering = true;
        _physics = false;
        StateHasChanged();

        // Streaming avoids building one large interop string for multi-MB graphs.
        var ms = new MemoryStream();
        await System.Text.Json.JsonSerializer.SerializeAsync(ms, graph, GraphJson.Options);
        ms.Position = 0;
        using var streamRef = new DotNetStreamReference(ms, leaveOpen: false);
        await _module!.InvokeVoidAsync("renderFromStream", streamRef);
    }

    public async Task ApplyFilterAsync(GraphFilterState filter)
    {
        if (_module is not null) await _module.InvokeVoidAsync("applyFilter", filter);
    }

    public async Task<bool> FocusAsync(string id) =>
        _module is not null && await _module.InvokeAsync<bool>("focusNode", id);

    private async Task FitAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("fit");
    }

    private async Task TogglePhysicsAsync()
    {
        _physics = !_physics;
        if (_module is not null) await _module.InvokeVoidAsync("setPhysics", _physics);
    }

    [JSInvokable]
    public async Task OnRenderComplete(int nodes, int edges)
    {
        _nodeCount = nodes;
        _edgeCount = edges;
        _rendering = false;
        StateHasChanged();
        await OnRendered.InvokeAsync();
    }

    [JSInvokable("OnNodeSelected")]
    public Task NodeSelected(string? id) => OnNodeSelected.InvokeAsync(id);

    [JSInvokable("OnNodeOpen")]
    public Task NodeOpen(string id) => OnNodeOpen.InvokeAsync(id);

    [JSInvokable("OnEdgeSelected")]
    public Task EdgeSelected(string? id) => OnEdgeSelected.InvokeAsync(id);

    public async Task UpdateNodeTagsAsync(string id, IReadOnlyDictionary<string, string> tags)
    {
        if (_module is not null) await _module.InvokeVoidAsync("updateNodeTags", id, tags);
    }

    public async Task HighlightChangesAsync(IEnumerable<string> addedIds, IEnumerable<string> changedIds)
    {
        if (_module is not null) await _module.InvokeVoidAsync("highlightChanges", addedIds, changedIds);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; there is nothing left to clean up in the browser.
        }
        _selfRef?.Dispose();
    }
}
