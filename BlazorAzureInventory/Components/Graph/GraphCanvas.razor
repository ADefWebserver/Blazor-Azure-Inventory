@implements IAsyncDisposable
@using BlazorAzureInventory.Models.Options
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ILogger<GraphCanvas> Logger
@inject Microsoft.Extensions.Options.IOptions<GraphViewOptions> GraphViewOptions

<div class="graph-canvas-host">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2" Wrap="FlexWrap.Wrap">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Fit" Icon="fit_screen" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@FitAsync" />
        </RadzenStack>
        <RadzenText TextStyle="TextStyle.Caption" class="muted rz-m-0 graph-count" aria-live="polite">@CountCaption</RadzenText>
    </RadzenStack>
    <div id="@_containerId" class="graph-canvas"></div>
    <details class="graph-legend">
        <summary>Legend</summary>
        <ul id="@_legendId" aria-label="Legend"></ul>
    </details>
    @if (_rendering)
    {
        <div class="graph-overlay">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            <RadzenText TextStyle="TextStyle.Body2" class="muted">Rendering graph...</RadzenText>
        </div>
    }
</div>

@code {
    [Parameter] public GraphViewPayload? View { get; set; }
    [Parameter] public GraphFilterState Filter { get; set; } = new();
    [Parameter] public EventCallback<int?> OnNodeSelected { get; set; }
    [Parameter] public EventCallback<int> OnNodeOpen { get; set; }
    [Parameter] public EventCallback<int?> OnEdgeSelected { get; set; }
    [Parameter] public EventCallback OnRendered { get; set; }
    private readonly string _containerId = $"graph-{Guid.NewGuid():N}";
    private readonly string _legendId = $"graph-legend-{Guid.NewGuid():N}";
    private int? _visibleNodes;

    private string CountCaption => View is null
        ? string.Empty
        : $"Showing {(_visibleNodes ?? _nodeCount):N0} of {Math.Max(View.TotalNodes, _visibleNodes ?? _nodeCount):N0} nodes";
    private IJSObjectReference? _module;
    private DotNetObjectReference<GraphCanvas>? _selfRef;
    private GraphViewPayload? _renderedView;
    private bool _rendering = true;
    private int _nodeCount;
    private int _edgeCount;
    private long _payloadBytes;
    private readonly System.Diagnostics.Stopwatch _renderClock = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/graph-view.js");
            _selfRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _containerId, _selfRef,
                new { webgl = GraphViewOptions.Value.UseWebGl, hoverMax = GraphViewOptions.Value.HoverHighlightMaxElements, timings = Env.IsDevelopment(), legendId = _legendId });
            await ApplyFilterAsync(Filter, null);
        }

        if (_module is not null && View is not null && !ReferenceEquals(View, _renderedView))
        {
            _renderedView = View;
            await RenderGraphAsync(View);
        }
    }

    private async Task RenderGraphAsync(GraphViewPayload view)
    {
        _rendering = true;
        _visibleNodes = null;
        StateHasChanged();
        _renderClock.Restart();

        await using var stream = new MemoryStream();
        await System.Text.Json.JsonSerializer.SerializeAsync(stream, view, GraphViewJson.Options);
        _payloadBytes = stream.Length;
        stream.Position = 0;
        using var streamRef = new DotNetStreamReference(stream, leaveOpen: true);
        await _module!.InvokeVoidAsync("render", streamRef);
    }

    public async Task ApplyFilterAsync(GraphFilterState filter, IReadOnlyList<int>? tagMatches)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("applyFilter", filter, tagMatches);
    }

    public async Task<bool> CenterAsync(int index) =>
        _module is not null && await _module.InvokeAsync<bool>("center", index);

    public async Task<bool> CopyTextAsync(string text) =>
        _module is not null && await _module.InvokeAsync<bool>("copyText", text);

    private async Task FitAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("fit");
    }

    [JSInvokable]
    public async Task OnRenderComplete(int nodes, int edges, double ms)
    {
        if (Env.IsDevelopment())
        {
            Logger.LogInformation("Graph rendered {Nodes} nodes, {Edges} edges: payload {Bytes} bytes, browser {BrowserMs:F0} ms, round trip {TotalMs:F0} ms",
                nodes, edges, _payloadBytes, ms, _renderClock.Elapsed.TotalMilliseconds);
        }
        _nodeCount = nodes;
        _edgeCount = edges;
        _rendering = false;
        StateHasChanged();
        await OnRendered.InvokeAsync();
    }

    [JSInvokable]
    public Task OnVisibleCounts(int nodes, int edges)
    {
        _visibleNodes = nodes;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable("OnNodeSelected")]
    public Task NodeSelected(int? index) => OnNodeSelected.InvokeAsync(index);

    [JSInvokable("OnNodeOpen")]
    public Task NodeOpen(int index) => OnNodeOpen.InvokeAsync(index);

    [JSInvokable("OnEdgeSelected")]
    public Task EdgeSelected(int? index) => OnEdgeSelected.InvokeAsync(index);

    [JSInvokable]
    public Task OnWebGlFallback()
    {
        Logger.LogInformation("Cytoscape WebGL renderer unavailable; using canvas rendering");
        return Task.CompletedTask;
    }

    public async Task HighlightChangesAsync(IReadOnlyList<int> added, IReadOnlyList<int> changed)
    {
        if (_module is not null) await _module.InvokeVoidAsync("highlightChanges", added, changed);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; there is nothing left to clean up in the browser.
        }
        _selfRef?.Dispose();
    }
}
