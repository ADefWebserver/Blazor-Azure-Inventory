<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>b7e3f2a4-5c1d-4e8f-9a6b-3d2c1e0f4a59</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorAzureInventorySolution.ServiceDefaults\BlazorAzureInventorySolution.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorAzureInventory.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.ResourceManager" Version="1.14.0" />
    <PackageReference Include="Azure.ResourceManager.AppContainers" Version="1.6.0" />
    <PackageReference Include="Azure.ResourceManager.AppService" Version="1.5.0" />
    <PackageReference Include="Azure.ResourceManager.ResourceGraph" Version="1.1.1" />
    <PackageReference Include="Azure.ResourceManager.Storage" Version="1.8.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.0" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.16.0" />
    <PackageReference Include="Microsoft.Msagl" Version="1.1.6" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Radzen.Blazor" Version="12.0.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>

</Project>
